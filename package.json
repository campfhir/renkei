{
  "name": "renkei-monorepo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "pnpm --filter renkei dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "changelog": "node scripts/changelog.mjs"
  },
  "devDependencies": {
    "@campfhir/safe-functions": "^0.1.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
