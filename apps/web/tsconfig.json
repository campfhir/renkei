{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@renkei/agents": ["../../packages/agents/src/index.ts"],
      "@renkei/agents/runs": ["../../packages/agents/src/runs.ts"],
      "@renkei/agent-llm": ["../../packages/agent-llm/src/index.ts"],
      "@renkei/db": ["../../packages/db/src/index.ts"],
      "@renkei/crypto": ["../../packages/crypto/src/index.ts"],
      "@renkei/notifications": ["../../packages/notifications/src/index.ts"],
      "@renkei/email-sanitizer": ["../../packages/email-sanitizer/src/index.ts"],
      "@renkei/provider-grants": ["../../packages/provider-grants/src/index.ts"],
      "@renkei/capability-registry": ["../../packages/capability-registry/src/index.ts"],
      "@renkei/connector-webex": ["../../packages/connector-webex/src/index.ts"],
      "@renkei/connector-fileshares": ["../../packages/connector-fileshares/src/index.ts"],
      "@renkei/connector-fileshares/pure": ["../../packages/connector-fileshares/src/pure.ts"],
      "@renkei/connector-onbase": ["../../packages/connector-onbase/src/index.ts"],
      "@renkei/connector-microsoft": ["../../packages/connector-microsoft/src/index.ts"],
      "@renkei/connector-atlassian": ["../../packages/connector-atlassian/src/index.ts"],
      "@renkei/connector-zoom": ["../../packages/connector-zoom/src/index.ts"],
      "@renkei/connector-config": ["../../packages/connector-config/src/index.ts"],
      "@renkei/settings": ["../../packages/settings/src/index.ts"],
      "@renkei/tool-outcomes": ["../../packages/tool-outcomes/src/index.ts"],
      "@renkei/user-prefs": ["../../packages/user-prefs/src/index.ts"],
      "@renkei/user-prefs/prefs": ["../../packages/user-prefs/src/prefs.ts"],
      "@renkei/gates": ["../../packages/gates/src/index.ts"],
      "@renkei/redaction": ["../../packages/redaction/src/index.ts"],
      "@renkei/document-text": ["../../packages/document-text/src/index.ts"],
      "@renkei/knowledge": ["../../packages/knowledge/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "scripts/**/*.ts",
    "app/**/.well-known/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
