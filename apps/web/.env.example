# Renkei environment — deliberately minimal (RENKEI.md Decision #19).
#
# The environment holds ONLY what is needed before the database can answer:
# the connection itself, the root encryption key, and process wiring.
# Everything else is configuration data and lives in the database:
#
#   - Atlassian OAuth app (client id/secret, scopes)  → connector_configs,
#     set via PUT /api/admin/{slug}/connectors/atlassian
#   - WebEx bot token + webhook secret                → connector_configs,
#     set via PUT /api/admin/{slug}/connectors/webex
#   - Public base URL                                 → platform_settings
#   - Org policy: read-only mode, DCR, token TTLs,
#     JQL/attachment/rate limits                      → tenant_settings

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://renkei:renkei@localhost:5432/renkei

# ── Root of trust ───────────────────────────────────────────────────────────
# AES-256 key sealing every secret at rest (grants, connector credentials,
# OIDC client secrets). It cannot live in the database it protects.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# AES-256 key encrypting secure()-marked log attributes (failed-request and
# response bodies, which can carry email/calendar PII) at rest. REQUIRED: the
# web and worker processes refuse to boot without a valid key rather than store
# those bodies in plaintext. Distinct from TOKEN_ENCRYPTION_KEY on purpose — a
# log-reading key must not also unseal every provider token.
# Generate with: openssl rand -base64 32
LOG_ENCRYPTION_KEY=

# ── Process wiring ──────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=3000

# Console log level for the web process (debug | info | warn | error).
# CONSOLE_LOG_LEVEL=info

# Comma-separated proxy IPs whose X-Forwarded-* headers are trusted when
# deriving the public origin. Must be decidable before the database is
# involved, so it stays here. Default: localhost only.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# ── Chat attachments ────────────────────────────────────────────────────────
# Object storage for files uploaded into the chat. Unset = uploads off.
# The only backend today is Azure Blob Storage; see DEPLOYMENT.md.
# BLOB_STORE_PROVIDER=azure
# AZURE_BLOB_ACCOUNT=
# AZURE_BLOB_KEY=
# AZURE_BLOB_CONTAINER=renkei-chat
# AZURE_BLOB_ENDPOINT=
