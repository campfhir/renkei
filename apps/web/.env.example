# ─── Shared (both the stdio entrypoint and the HTTP gateway) ────────────────

# Atlassian OAuth 2.0 (3LO) app — register at https://developer.atlassian.com/console/myapps/
# See docs/atlassian-private-app-setup.md
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Must match the callback URL registered on the app exactly, path included.
# For local stdio use: http://localhost:3000/oauth/callback
ATLASSIAN_REDIRECT_URI=https://renkei.example.org/oauth/callback

# Granular scopes only — never manage:jira-* or any admin scope.
# Classic scopes (read:jira-work, write:jira-work, read:jira-user) are NOT a
# security boundary: measured against the OpenAPI spec they reach 154 GET and
# 94 mutating endpoints, including /permissionscheme and /configuration. The
# list below is the granular equivalent, derived from JIRA_ENDPOINT_ALLOWLIST
# (src/jira/allowlist.ts) via scripts/scope-audit.ts — 31 Jira + 3 Jira
# Software + 20 JSM + read:me/read:account/offline_access.
# Re-derive it from the spec each release with:
#   pnpm tsx scripts/scope-audit.ts --env .env.example --emit
ATLASSIAN_SCOPES=delete:request.participant:jira-service-management delete:servicedesk.customer:jira-service-management offline_access read:account read:application-role:jira read:attachment:jira read:avatar:jira read:board-scope:jira-software read:comment.property:jira read:comment:jira read:customer:jira-service-management read:field-configuration:jira read:field.default-value:jira read:field.option:jira read:field:jira read:group:jira read:issue-details:jira read:issue-meta:jira read:issue-security-level:jira read:issue-worklog.property:jira read:issue-worklog:jira read:issue.changelog:jira read:issue.transition:jira read:issue.vote:jira read:issue:jira read:me read:project-role:jira read:project:jira read:request.approval:jira-service-management read:request.attachment:jira-service-management read:request.comment:jira-service-management read:request.participant:jira-service-management read:request.sla:jira-service-management read:request.status:jira-service-management read:request:jira-service-management read:requesttype:jira-service-management read:servicedesk.customer:jira-service-management read:servicedesk:jira-service-management read:sprint:jira-software read:status:jira read:user.property:jira read:user:jira write:attachment:jira write:comment.property:jira write:comment:jira write:customer:jira-service-management write:issue-worklog.property:jira write:issue-worklog:jira write:issue.property:jira write:issue:jira write:request.attachment:jira-service-management write:request.comment:jira-service-management write:request.participant:jira-service-management write:request.status:jira-service-management write:request:jira-service-management write:servicedesk.customer:jira-service-management write:sprint:jira-software

# The Jira Cloud site the stdio entrypoint (`pnpm auth`, Claude Desktop's local
# server) talks to. Find it at https://<site>.atlassian.net/_edge/tenant_info
#
# The HTTP gateway does not read this: which site a request reaches comes from
# the `/mcp/<tenantSiteId>` it resolved, claimed through the console, the
# self-service wizard at `/`, or `pnpm tenant claim-site` — never from config.
ATLASSIAN_CLOUD_ID=

# Token encryption at rest (AES-256-GCM). Must decode to exactly 32 bytes:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Request limits
MAX_JQL_RESULTS=100
RATE_LIMIT_PER_USER_PER_MINUTE=60

# Largest file an upload tool will accept, in decoded bytes. Attachment content
# arrives base64-encoded inside the JSON-RPC message, which inflates it by a
# third and holds the whole thing in memory — so this is deliberately a third
# of Jira Cloud's own 10 MB default rather than matching it. Hard ceiling 10 MiB.
MAX_ATTACHMENT_BYTES=3145728

# Withhold every mutating tool. They are not registered at all, so they never
# appear in tools/list — a model cannot attempt a tool it cannot see. Only the
# exact string `true` enables it; anything else is a startup error rather than
# a silent fallback, so a typo cannot leave writes on when you meant them off.
READ_ONLY=false

# Logging
LOG_LEVEL=info

# ─── stdio entrypoint only (see docs/claude-desktop-setup.md) ───────────────

# Where the single encrypted grant is stored. Defaults to ~/.renkei/tokens.json.
# TOKEN_STORE_PATH=

# ─── HTTP gateway only ──────────────────────────────────────────────────────
# Unset for stdio; required by `pnpm start`.

PORT=3000
HOST=0.0.0.0

# The public origin AI clients connect to. Every discovery document, redirect,
# and token audience is derived from it, so it must be the externally visible
# URL — not the container's address.
#
# ATLASSIAN_REDIRECT_URI above must equal <PUBLIC_BASE_URL>/oauth/callback, and
# the gateway refuses to start if it does not. A mismatch would otherwise
# produce a sign-in that succeeds at Atlassian and then 404s.
PUBLIC_BASE_URL=https://renkei.example.org

# Postgres (sessions, encrypted tokens, audit log only — no Jira data at rest)
#
# The request path. In production this should be a login role granted
# `renkei_app` and nothing else — migration 013 creates that as a NOLOGIN
# privilege bundle:
#
#   CREATE ROLE renkei_rt LOGIN PASSWORD '...';
#   GRANT renkei_app TO renkei_rt;
#
DATABASE_URL=postgres://renkei:renkei@localhost:5432/renkei

# Not read by the running gateway at all — only compared against DATABASE_URL
# to decide whether to warn at boot. The value that matters is read directly
# from the environment by `pnpm migrate` and `pnpm tenant`, which need
# privileges the request path must not have. Falls back to DATABASE_URL here,
# and the server warns at startup when both end up as one identity: row-level
# security does not apply to a superuser or to the owner of the tables, so a
# shared identity leaves every policy installed and inert.
# MIGRATION_DATABASE_URL=postgres://renkei:renkei@localhost:5432/renkei

# No tenant is created from this file. Once the gateway is up, create one by
# visiting PUBLIC_BASE_URL and walking the self-service "create your
# organization" flow, or headlessly with:
#   pnpm tenant create <slug> --name "Acme Health"
#   pnpm tenant claim-site <slug> --cloud-id <your Jira cloud ID>

# Session lifecycle. Inactivity is terminal: a session past the timeout is
# revoked rather than refreshable, or the timeout would mean nothing to a
# client that keeps refreshing.
SESSION_INACTIVITY_TIMEOUT_MINUTES=60
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
AUTHORIZATION_CODE_TTL_SECONDS=60

# Dynamic Client Registration (RFC 7591). On by default, which is what lets a
# hosted client such as Claude.ai self-register — the documented onboarding
# path. With it on, anyone who can reach the endpoint can create a client; that
# is acceptable because a client alone can do nothing, and every capability
# arrives only after a human completes Atlassian sign-in within their own Jira
# permissions. Set false for a closed client list and register clients by hand.
ENABLE_DCR=true

# ─── The platform console (optional) ────────────────────────────────────────
#
# The deployment operator's own identity provider, and the surface at /platform
# that creates tenants and hands each one to its own operator.
#
# From the environment rather than a table, unlike a tenant's provider in
# `tenant_oidc`. There is exactly one of these, and the surface that would
# configure it is the console it gates — which is the bootstrap this exists to
# break, so it cannot come from a row only a privileged connection could write.
#
# Leave unset on a single-organization deployment: /platform and /onboard are then
# not registered at all, so there is no new surface to reason about. Set all four
# or none of them.
#
# Register <PUBLIC_BASE_URL>/platform/callback as a redirect URI.
#
# PLATFORM_OIDC_ISSUER=https://login.example.com/
# PLATFORM_OIDC_CLIENT_ID=
# PLATFORM_OIDC_CLIENT_SECRET=
# PLATFORM_OIDC_ROLE_CLAIM=groups

# Required whenever the three above are set — unlike a tenant's, where it may be
# null. The asymmetry is blast radius: for a tenant, omitting it means "anyone
# this provider authenticates operates this tenant", which is that organization's
# own call about its own directory. Here it would mean anyone a possibly-shared
# corporate directory knows can create tenants and mint an onboarding link for any
# existing one. Granting deployment-wide authority must not be reachable by
# leaving a variable unset, so the server refuses to start without it.
#
# PLATFORM_OIDC_REQUIRED_ROLE=renkei-platform

# The platform console's own database identity: a login role granted
# `renkei_platform` and nothing else, created by migration 019.
#
#   CREATE ROLE renkei_pf LOGIN PASSWORD '...';
#   GRANT renkei_platform TO renkei_pf;
#
# That role can enumerate tenants — which the request path deliberately cannot —
# and is refused every table holding tenant data, including the one column of
# `tenant_oidc` holding a tenant's provider credential. That column-level refusal
# is what makes "a platform operator cannot read tenant data" a fact about the
# database rather than about which methods somebody wrote.
#
# Falls back to MIGRATION_DATABASE_URL, which works and gives up that guarantee,
# so the server warns at startup.
# PLATFORM_DATABASE_URL=postgres://renkei_pf:...@localhost:5432/renkei

# ─── End-to-end tests (optional) ────────────────────────────────────────────
#
# Credentials the Playwright OIDC suite signs in with. Read from the
# environment, never written into a spec: a spec that hardcodes them puts them
# in the repository, and a failing test then copies the source into
# test-results/*/error-context.md, which is how a live Azure AD client secret
# ended up committed and was caught by GitHub push protection on first push.
#
# test-results/ and playwright-report/ are gitignored for the same reason, but
# the ignore only stops the artifact — the source is what must not hold it.
#
# A suite missing these should skip rather than fail: they are absent on any
# machine that is not running the OIDC tests.
#
# E2E_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# E2E_OIDC_CLIENT_ID=
# E2E_OIDC_CLIENT_SECRET=
# E2E_OIDC_USERNAME=
# E2E_OIDC_PASSWORD=
