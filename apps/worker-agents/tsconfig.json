{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "paths": {
      "@renkei/db": ["../../packages/db/src/index.ts"],
      "@renkei/crypto": ["../../packages/crypto/src/index.ts"],
      "@renkei/queue": ["../../packages/queue/src/index.ts"],
      "@renkei/settings": ["../../packages/settings/src/index.ts"],
      "@renkei/agents": ["../../packages/agents/src/index.ts"],
      "@renkei/agents/runs": ["../../packages/agents/src/runs.ts"],
      "@renkei/agents/event-fanout": ["../../packages/agents/src/event-fanout.ts"],
      "@renkei/agent-llm": ["../../packages/agent-llm/src/index.ts"],
      "@renkei/worker-loop": ["../../packages/worker-loop/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
