# Production environment variables for Renkei
# Copy this to .env and configure for your deployment

# ────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ────────────────────────────────────────────────────────────────────────────

# PUBLIC_BASE_URL is the single source of truth for the application's public URL
# This is what clients use to access the app, and what must be registered with
# OAuth providers (Atlassian, Azure AD, etc.)
# Examples: https://renkei.example.com, https://example.com/renkei
PUBLIC_BASE_URL=https://example.com

# For development/testing behind a reverse proxy without PUBLIC_BASE_URL set:
# Whitelist the proxy IPs that are allowed to set X-Forwarded-* headers
# Default (if not set): 127.0.0.1,::1 (localhost only)
# Docker bridge network: 172.17.0.1
# Kubernetes/overlay networks: add pod/service CIDR (e.g., 10.0.0.0/24)
# TRUSTED_PROXY_IPS=127.0.0.1,172.17.0.1

# ────────────────────────────────────────────────────────────────────────────
# Atlassian OAuth (3-legged OAuth for Jira)
# ────────────────────────────────────────────────────────────────────────────

ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Must match PUBLIC_BASE_URL:
ATLASSIAN_REDIRECT_URI=https://example.com/api/oauth/callback
ATLASSIAN_SCOPES=read:me read:account read:jira-work write:jira-work read:jira-user read:servicedesk-request write:servicedesk-request offline_access
ATLASSIAN_CLOUD_ID=

# ────────────────────────────────────────────────────────────────────────────
# Encryption & Security
# ────────────────────────────────────────────────────────────────────────────

# AES-256-GCM key for encrypting tokens at rest
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ────────────────────────────────────────────────────────────────────────────
# Session & Rate Limiting
# ────────────────────────────────────────────────────────────────────────────

SESSION_INACTIVITY_TIMEOUT_MINUTES=60
MAX_JQL_RESULTS=100
RATE_LIMIT_PER_USER_PER_MINUTE=60

# ────────────────────────────────────────────────────────────────────────────
# Logging
# ────────────────────────────────────────────────────────────────────────────

LOG_LEVEL=info
