{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "paths": {
      "@renkei/db": ["../../packages/db/src/index.ts"],
      "@renkei/crypto": ["../../packages/crypto/src/index.ts"],
      "@renkei/connector-config": ["../../packages/connector-config/src/index.ts"],
      "@renkei/gates": ["../../packages/gates/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
