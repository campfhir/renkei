{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "paths": {
      "@renkei/db": ["../../packages/db/src/index.ts"],
      "@renkei/guards": ["../../packages/guards/src/index.ts"],
      "@renkei/delegate-client": ["../../packages/delegate-client/src/index.ts"],
      "@renkei/provider-grants": ["../../packages/provider-grants/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
